generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Barber {
  id           Int           @id @default(autoincrement())
  name         String
  color        String
  imageUrl     String?
  appointments Appointment[]
  schedules    Schedule[]
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String
  duration     Int
  price        Float
  appointments Appointment[]
}

model Appointment {
  id            Int      @id @default(autoincrement())
  customerName  String
  customerEmail String
  startDate     DateTime
  status        String   @default("PENDING")
  barberId      Int
  serviceId     Int
  customerPhone String?
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  barber        Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Schedule {
  id        Int     @id @default(autoincrement())
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean @default(true)
  barberId  Int
  barber    Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek])
}

model AboutInfo {
  id        Int      @id @default(autoincrement())
  story     String
  address   String
  hours     String
  mapsUrl   String
  updatedAt DateTime @updatedAt
}

model AboutImage {
  id        Int      @id @default(autoincrement())
  url       String
  title     String
  subtitle  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
